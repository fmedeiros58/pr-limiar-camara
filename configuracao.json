      "largura_letras_por_campo": 4,
      "base": 25,
      "indice_numerico": 1,
      "separador_visual_entre_coordenadas": " ",
      "comprimento_bloco_original": 12,
      "observacao": "Codificar cada numero como inteiro de base 25 em quatro letras, com A=0 ate Z=24 (sem J), utilizando numero-1. Decifrar e somar 1. Rejeitar valores fora da matriz."
    }
  },
  "randomizacao": {
    "habilitada": true,
