      "comprimento_maximo_palavra": 24,
      "ignorar_numeros": true,
      "ignorar_palavras_somente_de_uma_letra": true
    },
    "evitar_mesma_palavra_repetida_no_desafio": true,
    "metodo_de_escolha": "amostragem_uniforme_com_rejeicao_para_evitar_vies_de_modulo"
